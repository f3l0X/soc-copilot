# ─── LLM ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_me
# Free tier daily request quotas vary by model:
#   gemini-2.5-flash       → ~20 req/día
#   gemini-2.5-flash-lite  → más generoso, recomendado para dev
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=soc
POSTGRES_PASSWORD=replace_with_strong_secret
POSTGRES_DB=soc_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ─── API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=http://localhost:13500

# Rate limit (per client IP, in-memory). Disable for load tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Auth (Phase 4) ────────────────────────────────────────────────────────
# Generate a real secret BEFORE deploying:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-32+chars-please-rotate-on-deploy
JWT_TTL_SECONDS=3600
COOKIE_NAME=soc_session
# Set to true ONLY behind HTTPS (Caddy in prod). In local dev keep false.
COOKIE_SECURE=false

# After bootstrap, set ALLOW_PUBLIC_REGISTRATION=false and create accounts
# from the admin panel. Leaving it true lets anyone self-register as an
# analyst.
ALLOW_PUBLIC_REGISTRATION=true

# Either "development" or "production". In production the API refuses to
# start with default JWT/Postgres secrets, hides Swagger, and forces
# secure cookies + HSTS.
APP_ENV=development

# ─── Per-user secrets ───────────────────────────────────────────────────────
# Fernet key (urlsafe base64, 32 bytes) — encrypts user-supplied Gemini
# API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Daily LLM call budget when a user is on the SHARED server key.
SERVER_LLM_DAILY_QUOTA=50

# ─── Web (Next.js) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:13500
