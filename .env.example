# ─── LLM ────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=replace_me
# Free tier daily request quotas vary by model:
#   gemini-2.5-flash       → ~20 req/día
#   gemini-2.5-flash-lite  → más generoso, recomendado para dev
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# ─── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=soc
POSTGRES_PASSWORD=replace_with_strong_secret
POSTGRES_DB=soc_copilot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── ChromaDB ───────────────────────────────────────────────────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ─── API ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=http://localhost:13500

# Rate limit (per client IP, in-memory). Disable for load tests.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Auth (Phase 4) ────────────────────────────────────────────────────────
# Generate a real secret BEFORE deploying:
#   openssl rand -base64 48
JWT_SECRET=dev-only-change-me-32+chars-please-rotate-on-deploy
JWT_TTL_SECONDS=3600
COOKIE_NAME=soc_session
# Set to true ONLY behind HTTPS (Caddy in prod). In local dev keep false.
COOKIE_SECURE=false

# After bootstrap, set ALLOW_PUBLIC_REGISTRATION=false and create accounts
# from the admin panel. Leaving it true lets anyone self-register as an
# analyst.
ALLOW_PUBLIC_REGISTRATION=true

# Allowlist of chat models the frontend can switch to (CSV). Each must
# support response_mime_type=application/json + response_schema so
# /api/explain and /api/recommend keep parsing structured output.
GEMINI_CHAT_MODELS_ALLOWLIST=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-2.0-flash-lite

# Either "development" or "production". In production the API refuses to
# start with default JWT/Postgres secrets, hides Swagger, and forces
# secure cookies + HSTS.
APP_ENV=development

# ─── Brute-force lockout ────────────────────────────────────────────────────
# Threshold of consecutive failed logins before the account is locked.
# Lock auto-expires after AUTH_LOCKOUT_MINUTES.
AUTH_LOCKOUT_THRESHOLD=4
AUTH_LOCKOUT_MINUTES=15

# ─── Email verification + SMTP ──────────────────────────────────────────────
# When true, /auth/login rejects users that haven't clicked their link.
# Leave SMTP_HOST empty to skip real delivery (dev only — the token is
# returned in the API response so flows are demoable offline).
AUTH_REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_HOURS=24
# Base URL of the frontend; used to build the verification link.
WEB_BASE_URL=http://localhost:13500

# Gmail example (App Password, requires 2FA on the account):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_STARTTLS=true
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASSWORD=<16-char-app-password>
#   SMTP_FROM=youraddress@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# ─── Per-user secrets ───────────────────────────────────────────────────────
# Fernet key (urlsafe base64, 32 bytes) — encrypts user-supplied Gemini
# API keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Daily LLM call budget when a user is on the SHARED server key.
SERVER_LLM_DAILY_QUOTA=50

# ─── Web (Next.js) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Backups (solo producción) ──────────────────────────────────────────────
# Usados por scripts/backup_postgres.sh (systemd timer soc-copilot-backup).
# REQUERIDA para el backup cifrado: clave PÚBLICA age del destinatario.
# Genera el par con `age-keygen -o ~/.age-key.txt`; la línea "public key:"
# es el recipient. Guarda la privada (~/.age-key.txt) fuera del server.
BACKUP_AGE_RECIPIENT=
# Opcionales (con defaults en el script):
# BACKUP_DIR=/var/backups/soc-copilot
# BACKUP_RETENTION_DAILY=7
# BACKUP_RETENTION_WEEKLY=4
# BACKUP_RCLONE_REMOTE=          # p.ej. b2:soc-copilot-backups/postgres (offsite)
